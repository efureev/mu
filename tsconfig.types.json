{
  "extends": "./tsconfig",
  "compilerOptions": {
    "noEmit": false,

    "module": "ES2022",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist/types",

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "tests"]

}
