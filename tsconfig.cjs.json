{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    "module": "CommonJS",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist/cjs",

    "sourceMap": true,

    "declaration": false,
    "emitDeclarationOnly": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "tests"]

}
