{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    "module": "ES2022",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist/esm",

    "sourceMap": true,

    "declaration": false,
    "emitDeclarationOnly": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "tests"],
}
